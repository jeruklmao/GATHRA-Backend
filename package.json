{
  "name": "gathra-routing-backend",
  "version": "0.2.0",
  "private": true,
  "description": "GATHRA route-preview API backed by a private GraphHopper service",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11 <25"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "npm run test:unit",
    "test:unit": "jest --config test/jest-unit.json --runInBand",
    "test:integration": "bash scripts/run-integration-tests.sh",
    "test:integration:jest": "jest --config test/jest-integration.json --runInBand",
    "test:all": "npm run test:unit && npm run test:integration",
    "iot:token": "node scripts/generate-iot-gateway-token.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/swagger": "^11.2.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "overrides": {
    "js-yaml": "5.2.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.17",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
