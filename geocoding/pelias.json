{
  "logger": {
    "level": "info",
    "timestamp": true
  },
  "esclient": {
    "apiVersion": "7.x",
    "keepAlive": true,
    "requestTimeout": "120000",
    "hosts": [
      {
        "protocol": "http",
        "host": "pelias-elasticsearch",
        "port": 9200
      }
    ]
  },
  "elasticsearch": {
    "settings": {
      "index": {
        "number_of_shards": "1",
        "number_of_replicas": "0",
        "refresh_interval": "10s"
      }
    }
  },
  "schema": {
    "indexName": "gathra-geocoder-read"
  },
  "api": {
    "indexName": "gathra-geocoder-read",
    "accessLog": false,
    "exposeInternalDebugTools": false,
    "minSize": 1,
    "maxSize": 8,
    "defaultSize": 6,
    "targets": {
      "auto_discover": true,
      "auto_discover_required": true,
      "layers_by_source": {
        "gathra": [
          "venue"
        ]
      }
    },
    "defaultParameters": {
      "focus.point.lat": -6.2202,
      "focus.point.lon": 106.7516
    },
    "services": {
      "placeholder": {
        "url": "http://pelias-placeholder:4100",
        "timeout": 1000,
        "retries": 1
      },
      "pip": {
        "url": "http://pelias-pip:4200",
        "timeout": 1000,
        "retries": 1
      },
      "libpostal": {
        "url": "http://pelias-libpostal:4400",
        "timeout": 1200,
        "retries": 1
      }
    }
  },
  "imports": {
    "adminLookup": {
      "enabled": true,
      "maxConcurrentRequests": 20,
      "usePostalCities": true
    },
    "openstreetmap": {
      "datapath": "/data/openstreetmap",
      "leveldbpath": "/tmp",
      "import": [
        {
          "filename": "gathra-supported-region.osm.pbf"
        }
      ]
    },
    "whosonfirst": {
      "datapath": "/data/whosonfirst",
      "countryCode": "ID",
      "importPostalcodes": true,
      "importVenues": false
    },
    "csv": {
      "datapath": "/data/csv",
      "files": [
        "gathra-poi.csv"
      ]
    }
  }
}
