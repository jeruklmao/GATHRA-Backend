# Port published by Docker Compose for the Nest API.
GATHRA_BACKEND_PORT=3000

# PostgreSQL is mandatory for raw IoT telemetry. These checked-in values are
# local-development defaults only; deployments must supply unique credentials.
POSTGRES_DB=gathra
POSTGRES_USER=gathra
POSTGRES_PASSWORD=gathra-local-only
# Host processes may override this directly. Compose constructs the equivalent
# internal URL from the three POSTGRES_* variables above.
DATABASE_URL=postgresql://gathra:gathra-local-only@127.0.0.1:5432/gathra

# SHA-256 digest only. Generate a raw token + digest with `npm run iot:token`,
# provision the raw token to the Gateway once, and keep it out of Git/logs.
IOT_GATEWAY_TOKEN_SHA256=
IOT_MAX_BATCH_SIZE=50
IOT_MONITOR_MAX_LIMIT=1000
# Comma-separated exact browser origins; paths and wildcard origins are rejected.
IOT_MONITOR_ALLOWED_ORIGINS=https://gathra.my.id

# Use the tiny checked-in Jakarta road graph for local smoke tests.
# Replace this with an absolute path to a regional .osm.pbf for broader coverage.
GATHRA_OSM_FILE=./routing-engine/fixtures/jakarta-sample.osm

# Backend-to-GraphHopper timeout. Android has its own client-side timeout.
ROUTING_ENGINE_TIMEOUT_MS=8000

# Keep heap limits appropriate for the selected OSM extract.
GRAPH_HOPPER_JAVA_OPTS=-Xms256m -Xmx1g

# Keep 0 for the tiny fixture. Use GraphHopper's recommended baseline of 200
# for a real regional road graph to avoid snapping onto small detached islands.
GRAPH_HOPPER_MIN_NETWORK_SIZE=0

# Flood mutation endpoints are unauthenticated development tools and fail
# closed. Set true only for an isolated local simulation session.
FLOOD_PROVIDER=in-memory
ENABLE_DEV_FLOOD_ENDPOINTS=false

# Authenticated administration is a separate fail-closed surface. When enabled,
# provide only the lowercase SHA-256 digest of a 64-character hexadecimal bearer
# token here; keep the raw token in a mode-600 file outside the repository.
ENABLE_FLOOD_ADMIN_ENDPOINTS=false
FLOOD_ADMIN_TOKEN_SHA256=
MAX_ACTIVE_FLOOD_HAZARDS=50
MAX_FLOOD_POLYGON_VERTICES=2000

# Photon is the primary self-hosted geocoder. Set fake for deterministic
# backend development that does not need the local Photon database.
GEOCODING_PROVIDER=photon
PHOTON_BASE_URL=http://photon:2322
PHOTON_JAVA_OPTS=-Xms128m -Xmx384m
PHOTON_MEMORY_LIMIT=512m
PHOTON_CPUS=1.5
GEOCODING_PROVIDER_TIMEOUT_MS=2500

# Compose allows 180 requests per minute for repeatable local corpus runs while
# retaining a per-client guard. Tune this down for a public deployment.
GEOCODING_RATE_LIMIT=180
GEOCODING_RATE_WINDOW_MS=60000

# The bounding box logic forces out-of-bounds clicks to be rejected. If the
# map is clicked beyond this box, the Android preview fails safely rather
# than routing users into unindexed areas.
GEOCODING_REGION_VERSION=gathra-jakarta-tangerang-buffer-v1

# Explicit Photon data acquisition. The script verifies this official MD5
# before changing an empty photon-data volume.
PHOTON_DATA_URL=https://download1.graphhopper.com/public/extracts/by-country-code/id/photon-db-id-250720.tar.bz2
PHOTON_DATA_MD5=0e027552ff841b12a2c703cf290daad2
