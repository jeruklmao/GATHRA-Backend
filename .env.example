# Port published by Docker Compose for the Nest API.
GATHRA_BACKEND_PORT=3000

# Use the tiny checked-in Jakarta road graph for local smoke tests.
# Replace this with an absolute path to a regional .osm.pbf for broader coverage.
GATHRA_OSM_FILE=./routing-engine/fixtures/jakarta-sample.osm

# Backend-to-GraphHopper timeout. Android has its own client-side timeout.
ROUTING_ENGINE_TIMEOUT_MS=8000

# Keep heap limits appropriate for the selected OSM extract.
GRAPH_HOPPER_JAVA_OPTS=-Xms256m -Xmx1g

# Keep 0 for the tiny fixture. Use GraphHopper's recommended baseline of 200
# for a real regional road graph to avoid snapping onto small detached islands.
GRAPH_HOPPER_MIN_NETWORK_SIZE=0

# Geocoding stays deterministic unless the Pelias profile is explicitly enabled.
# Start the real pilot with:
# GEOCODING_PROVIDER=pelias docker compose --profile geocoding up --build --wait
GEOCODING_PROVIDER=fake
GEOCODING_PROVIDER_TIMEOUT_MS=2500
# Compose allows 180 requests per minute for repeatable local corpus runs while
# retaining a per-client guard. Tune this down for a public deployment.
GEOCODING_RATE_LIMIT=180
GEOCODING_RATE_WINDOW_MS=60000

# Host path mounted at /data by explicit Pelias import jobs and read-only runtime
# services. Keep downloads and generated indexes out of Git.
GATHRA_GEOCODING_DATA_DIR=./geocoding/data

# Regional source and extract parameters. See geocoding/region/region-config.json.
GATHRA_GEOCODING_OSM_SOURCE_URL=https://download.geofabrik.de/asia/indonesia/java-latest.osm.pbf
GATHRA_GEOCODING_OSM_FILE=./geocoding/data/openstreetmap/gathra-supported-region.osm.pbf

# Local pilot resource defaults. A 16 GiB host is recommended when routing and
# all Pelias runtime services run together.
PELIAS_ELASTICSEARCH_JAVA_OPTS=-Xms2g -Xmx2g
PELIAS_ELASTICSEARCH_MEMORY_LIMIT=3g
PELIAS_LIBPOSTAL_MEMORY_LIMIT=4g
PELIAS_API_MEMORY_LIMIT=768m
PELIAS_PLACEHOLDER_MEMORY_LIMIT=1g
PELIAS_PIP_MEMORY_LIMIT=1g
PELIAS_IMPORT_MEMORY_LIMIT=4g
